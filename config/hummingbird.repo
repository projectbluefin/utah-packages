# Hummingbird's own rebuilt packages -- every RPM here carries a hum disttag.
# It is an overlay, not a distribution: roughly 3,500 packages covering the
# base OS (openssl, glibc, python3, bootc) and no desktop stack at all. It is
# paired with a Fedora repository, exactly as Hummingbird pairs it upstream in
# images/variables.yml, and takes precedence via priority.
[public-hummingbird-x86_64-rpms]
name=public-hummingbird-x86_64-rpms
baseurl=https://packages.redhat.com/api/pulp-content/public-hummingbird/x86_64/
enabled=1
sslverify=1
# Hummingbird's own repo file ships gpgcheck=0 for its lockfile tooling, but
# its RPMs are signed by Red Hat release keys 2 (v4 RSA) and 4 (v6
# ML-DSA-87+Ed448), both pinned in config/keys/; dnf5 needs both. Every
# job that installs from this file mounts "$PWD/config:/repos"; the ones that
# only repoquery or resolve with --assumeno never read the key.
gpgcheck=1
gpgkey=file:///repos/keys/RPM-GPG-KEY-redhat-release-2 file:///repos/keys/RPM-GPG-KEY-redhat-release-4
priority=10
zchunk=false
excludepkgs=ruby3.3-default-gems,ruby3.4-default-gems
# packages.redhat.com stalls mid-download under load. dnf's default aborts a
# transfer below 1000 B/s for 30 s and, with this single baseurl, then reports
# "All mirrors were tried": vulkan-headers lost glibc-minimal-langpack that
# way and took vulkan-loader with it (issue #1160). Wait out the stall instead.
minrate=1
timeout=300
