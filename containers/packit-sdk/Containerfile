ARG BASE_IMAGE=quay.io/fedora/fedora:44
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="packit-sdk"
LABEL org.opencontainers.image.description="Pinned Fedora Packit + Mock + createrepo_c build image for GitHub-native, Copr-free RPM builds"
LABEL org.opencontainers.image.source="https://github.com/projectbluefin/utah-packages"
LABEL org.opencontainers.image.licenses="MIT"

# Verified minimal dependency set: Fedora's `packit` RPM declares its own full
# runtime contract (rpm-build, git-core, rsync, working RPM/Kerberos Python
# bindings). Do NOT `pip install packit` here:
#   - PyPI's "packit" (0.30.0, NCBI) is an unrelated, squatted package name.
#   - The correct PyPI name, "packitos", still requires python3-rpm/krb5-devel/
#     gcc to compile outside a Fedora dnf install. The dnf path avoids all of
#     that entirely.
RUN dnf -y --setopt=install_weak_deps=False install \
        packit \
        mock \
        createrepo_c \
        rpmdevtools \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# GitHub Actions job containers and `docker run` mounts the checkout here.
RUN git config --system --add safe.directory /workspace

WORKDIR /workspace

# This image intentionally does NOT bake in a Hummingbird Mock root config.
# `packit build in-mock` requires it to be supplied at runtime via `--root`,
# so the factory-owned mock.cfg stays versioned in this repository and this
# image stays a generic Fedora Packit/Mock SDK.
ENTRYPOINT ["packit"]
CMD ["--help"]
