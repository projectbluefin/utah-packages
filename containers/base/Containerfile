ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:rawhide@sha256:4c075242b4a5e72c0206d87836d357a0689ff59b12b3f232e7dc904f64a23cfa
FROM ${BASE_IMAGE}

ARG REPOSITORY_URL
ARG VERSION=unknown

LABEL org.opencontainers.image.title="Hummingbird GitHub base"
LABEL org.opencontainers.image.description="Minimal Rawhide-derived bootc base rebuilt on GitHub Actions"
LABEL org.opencontainers.image.source="https://github.com/hanthor/hummingbird-github"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL containers.bootc=1

COPY system_files/shared /

RUN test -n "${REPOSITORY_URL}" && \
    printf '[hummingbird-github]\nname=Hummingbird GitHub RPM overlay\nbaseurl=%s\nenabled=1\ngpgcheck=1\nrepo_gpgcheck=0\n' "${REPOSITORY_URL}" \
      > /etc/yum.repos.d/hummingbird-github.repo && \
    dnf -y --refresh install ca-certificates && \
    dnf -y clean all && rm -rf /var/cache/dnf

RUN bootc container lint --fatal-warnings --skip nonempty-boot
CMD ["/sbin/init"]
