+    "F",   # pyflakes
+    "I",   # isort
+]
+ignore = []
+
+# Formatting (black-compatible)
+[tool.ruff.format]
+quote-style = "double"
+indent-style = "space"
+
+# Import sorting (isort-compatible)
+[tool.ruff.lint.isort]
+required-imports = ["from __future__ import annotations"]
