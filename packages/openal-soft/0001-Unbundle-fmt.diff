# This patch is used to unbundle fmt by fetching the system-wide
# fmt with cmake. Every target links alsoft::fmt, so alias it to the
# system library instead of renaming each link.

diff -up a/CMakeLists.txt.orig b/CMakeLists.txt
--- a/CMakeLists.txt.orig
+++ b/CMakeLists.txt
@@ -258,7 +258,8 @@ if(ALSOFT_ENABLE_MODULES)
 endif()
 
 
-add_subdirectory(fmt-11.2.0 EXCLUDE_FROM_ALL)
+find_package(fmt REQUIRED)
+add_library(alsoft::fmt ALIAS fmt::fmt)
 
 
 set(CPP_DEFS ) # C pre-processor, not C++
