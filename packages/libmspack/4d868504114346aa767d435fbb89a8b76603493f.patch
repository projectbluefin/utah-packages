From 4d868504114346aa767d435fbb89a8b76603493f Mon Sep 17 00:00:00 2001
From: Stuart Caie <kyzer@cabextract.org.uk>
Date: Mon, 15 Jun 2026 16:33:33 +0000
Subject: [PATCH] kwajd_read_headers(): initialise pointers before returning
 any error

---
 libmspack/ChangeLog                       |   7 +++++++
 libmspack/mspack/kwajd.c                  |   7 +++++--
 libmspack/test/kwajd_test.c               |   6 ++++++
 libmspack/test/test_files/kwajd/blank.kwj | Bin 0 -> 14 bytes
 libmspack/test/test_files/kwajd/empty.kwj |   0
 5 files changed, 18 insertions(+), 2 deletions(-)
 create mode 100644 libmspack/test/test_files/kwajd/blank.kwj
 create mode 100644 libmspack/test/test_files/kwajd/empty.kwj

diff --git a/libmspack/mspack/kwajd.c b/libmspack/mspack/kwajd.c
index 30caa89..ede91dd 100644
--- a/libmspack/mspack/kwajd.c
+++ b/libmspack/mspack/kwajd.c
@@ -160,6 +160,11 @@ static int kwajd_read_headers(struct mspack_system *sys,
     unsigned char buf[16];
     int i;
 
+
+    /* initialise pointers */
+    hdr->filename = NULL;
+    hdr->extra    = NULL;
+
     /* read in the header */
     if (sys->read(fh, &buf[0], kwajh_SIZEOF) != kwajh_SIZEOF) {
         return MSPACK_ERR_READ;
@@ -177,8 +182,6 @@ static int kwajd_read_headers(struct mspack_system *sys,
     hdr->data_offset  = EndGetI16(&buf[kwajh_DataOffset]);
     hdr->headers      = EndGetI16(&buf[kwajh_Flags]);
     hdr->length       = 0;
-    hdr->filename     = NULL;
-    hdr->extra        = NULL;
     hdr->extra_length = 0;
 
     /* optional headers */
diff --git a/libmspack/test/kwajd_test.c b/libmspack/test/kwajd_test.c
index 9425bf3..6fe771a 100644
--- a/libmspack/test/kwajd_test.c
+++ b/libmspack/test/kwajd_test.c
@@ -31,6 +31,12 @@ void kwajd_open_test_01() {
     TEST(hdr->filename == NULL);
     kwajd->close(kwajd, hdr);
 
+    TEST(!kwajd->open(kwajd, TESTFILE("empty.kwj")));
+    TEST(kwajd->last_error(kwajd) == MSPACK_ERR_READ);
+
+    TEST(!kwajd->open(kwajd, TESTFILE("blank.kwj")));
+    TEST(kwajd->last_error(kwajd) == MSPACK_ERR_SIGNATURE);
+
 #define GOOD(testfile, fname)                             \
     TEST(hdr = kwajd->open(kwajd, testfile));             \
     TEST(hdr->filename && !strcmp(fname, hdr->filename)); \
diff --git a/libmspack/test/test_files/kwajd/blank.kwj b/libmspack/test/test_files/kwajd/blank.kwj
new file mode 100644
index 0000000000000000000000000000000000000000..80023568107ecf6dd6095def597ce5eac83da921
GIT binary patch
literal 14
KcmZQzKn4H+4gdiF

literal 0
HcmV?d00001

diff --git a/libmspack/test/test_files/kwajd/empty.kwj b/libmspack/test/test_files/kwajd/empty.kwj
new file mode 100644
index 0000000..e69de29
