# Utah's shell experience: shell tools and prompt hooks, and the CLI Homebrew
# bundles. It replaces Universal Blue's ublue-bling and bling.sh/bling.fish in
# projectbluefin/utah (projectbluefin/common#1719); uwelcome stays the
# terminal greeting and bluefin-cli works through it. Fedora has no recipe;
# this one is modeled on Fedora's gum recipe (go-vendor-tools, vendored
# modules, license check).
#
# Source0 is generated by tools/generated_sources.py: the tag archive with the
# release's bluefin-cli-<version>-vendor.tar.gz unpacked into it, both
# SHA-512-pinned there. A version bump adds both digests to
# BLUEFIN_CLI_INPUT_SHA512 and relocks.
%bcond check 1

%global gomodulesmode GO111MODULE=on

Name:           bluefin-cli
Version:        0.15.0
Release:        1%{?dist}
ExclusiveArch:  %{golang_arches_future}
Summary:        Shell experience and command-line bundles for Bluefin
License:        Apache-2.0 AND BSD-2-Clause AND BSD-3-Clause AND MIT
URL:            https://github.com/tuna-os/bluefin-cli
Source0:        bluefin-cli-%{version}-vendored.tar.xz
Source1:        go-vendor-tools.toml

BuildRequires:  go-rpm-macros
BuildRequires:  go-vendor-tools
BuildRequires:  askalono-cli


%description
bluefin-cli sets up the Bluefin shell experience for bash, zsh and fish (eza,
bat, ugrep, zoxide, starship, direnv, mise and atuin hooks) and installs the
Bluefin command-line Homebrew bundles. Where uwelcome is installed it is the
terminal greeting, and bluefin-cli shows and toggles it; elsewhere bluefin-cli
prints its own message of the day. A copy installed in /usr/bin is updated by
the system package manager, not by itself.


%prep
%autosetup -p 1


%build
export GO_LDFLAGS="-X github.com/tuna-os/bluefin-cli/cmd.version=%{version}"
%gobuild -o bin/bluefin-cli .


%install
# licenses
%go_vendor_license_install -c %{S:1}

# command
install -D -p -m 0755 -t %{buildroot}%{_bindir} bin/bluefin-cli

# shell completions
export HOME="$(mktemp -d)" BLUEFIN_DISABLE_COUNTME=1
install -d -m 0755 %{buildroot}%{bash_completions_dir}
./bin/bluefin-cli completion bash > %{buildroot}%{bash_completions_dir}/bluefin-cli
install -d -m 0755 %{buildroot}%{zsh_completions_dir}
./bin/bluefin-cli completion zsh > %{buildroot}%{zsh_completions_dir}/_bluefin-cli
install -d -m 0755 %{buildroot}%{fish_completions_dir}
./bin/bluefin-cli completion fish > %{buildroot}%{fish_completions_dir}/bluefin-cli.fish


%check
export HOME="$(mktemp -d)" BLUEFIN_DISABLE_COUNTME=1
# ensure that the version was embedded correctly
[[ "$(./bin/bluefin-cli --version)" == "bluefin-cli version %{version}" ]] || exit 1

# license validation
%go_vendor_license_check -c %{S:1}

# upstream tests
%if %{with check}
# test/ is the CI integration suite: it runs the bluefin-cli binary from the
# source root and drives Homebrew, so it does not run in the build root.
%gocheck2 -t test
%endif


%files -f %{go_vendor_license_filelist}
%{_bindir}/bluefin-cli
%{bash_completions_dir}/bluefin-cli
%{zsh_completions_dir}/_bluefin-cli
%{fish_completions_dir}/bluefin-cli.fish


%changelog
* Fri Nov 20 2026 Utah Packages <packages@projectbluefin.io> - 0.15.0-1
- Initial recipe: Utah's shell experience, in place of ublue-bling
