--- a/lib/pycriu/images/Makefile
+++ b/lib/pycriu/images/Makefile
@@ -7,7 +7,13 @@
 # Unfortunately, we can't drop ugly _pb2 suffixes here, because
 # some _pb2 files depend on others _pb2 files.
 images:
-	$(Q) protoc -I=images/ -I=/usr/include/ --python_out=$(obj) $(proto)
+	# Ship the protobuf-3.19.x image bindings. The factory protoc (6.x) emits
+	# "from google.protobuf import runtime_version" at the top of every file, a
+	# module the pinned 3.19.6 runtime does not have, so import pycriu dies before
+	# the build ever runs. Regenerate nothing here: copy the 75 bindings built
+	# with protoc 3.19.6 instead. See criu-rpc_pb2.patch and utah-packages#983/#985.
+	$(Q) mkdir -p $(obj)
+	$(Q) cp -f $(PYCRIU_IMAGES_PB2)/* $(obj)/
 .PHONY: images
 
 $(obj)/magic.py: scripts/magic-gen.py criu/include/magic.h
