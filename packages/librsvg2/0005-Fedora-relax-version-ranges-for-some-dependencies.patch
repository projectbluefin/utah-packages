From 7c217c038956f0ed2b93d6ea8d2c262982a87733 Mon Sep 17 00:00:00 2001
From: Fabio Valentini <decathorpe@gmail.com>
Date: Tue, 15 Sep 2026 20:12:57 +0200
Subject: [PATCH 5/5] Fedora: relax version ranges for some dependencies

- widen nalgebra "^0.35" to ">=0.34,<0.36"
- widen string_cache "^0.9" to ">=0.9,<0.11"
---
 Cargo.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 0c7d5ab..323f26d 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -66,7 +66,7 @@ locale_config = "0.3.0"                                   # not "*" as per the d
 lopdf = "0.44"
 markup5ever = "0.39.0"
 matches = "0.1"
-nalgebra = "0.35.0"
+nalgebra = ">=0.34,<0.36"
 num-traits = "0.2"
 pango = "0.22.0"
 pangocairo = "0.22.0"
@@ -84,7 +84,7 @@ selectors = "0.40.0"
 serde = "1.0"
 serde_json = "1.0"
 shell-words = "1.1"
-string_cache = "0.10.0"
+string_cache = ">=0.9,<0.11"
 system-deps = "7.0.0"
 tempfile = "3"
 tinyvec = "1.2.0"
-- 
2.55.0

