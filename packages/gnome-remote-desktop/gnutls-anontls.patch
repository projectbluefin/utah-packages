From 58895f2dafcc208e5a5bcf2f6d40018016cee667 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Thu, 14 Jun 2018 12:21:37 +0200
Subject: [PATCH 1/6] session/vnc: Handle connection error signals too

---
 src/grd-session-vnc.c | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/src/grd-session-vnc.c b/src/grd-session-vnc.c
index b881b725d..038f04b1c 100644
--- a/src/grd-session-vnc.c
+++ b/src/grd-session-vnc.c
@@ -722,9 +722,16 @@ handle_socket_data (GSocket *socket,
                     GIOCondition condition,
                     gpointer user_data)
 {
-  GrdSessionVnc *session_vnc = user_data;
+  GrdSessionVnc *session_vnc = GRD_SESSION_VNC (user_data);
+  GrdSession *session = GRD_SESSION (session_vnc);
 
-  if (condition & G_IO_IN)
+  if (condition & (G_IO_ERR | G_IO_HUP))
+    {
+      g_warning ("Client disconnected");
+
+      grd_session_stop (session);
+    }
+  else if (condition & G_IO_IN)
     {
       if (rfbIsActive (session_vnc->rfb_screen))
         {
@@ -753,8 +760,8 @@ handle_socket_data (GSocket *socket,
     }
   else
     {
-      g_debug ("Unhandled socket condition %d\n", condition);
-      return G_SOURCE_REMOVE;
+      g_warning ("Unhandled socket condition %d\n", condition);
+      g_assert_not_reached ();
     }
 
   return G_SOURCE_CONTINUE;
@@ -767,7 +774,10 @@ grd_session_vnc_attach_source (GrdSessionVnc *session_vnc)
 
