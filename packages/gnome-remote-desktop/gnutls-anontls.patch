From bf5188fe5b3528aaf525d0b0eaa8a9eca5e57a57 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Thu, 14 Jun 2018 12:21:37 +0200
Subject: [PATCH 6/6] vnc: Add anonymous TLS encryption support

Add support for encrypting the VNC connection using anonymous TLS. In
effect this means that the channel is encrypted using TLS but that no
authentication of the peers are done. This means the connection is still
vulnerable to man-in-the-middle attacks where an attacker proxies the
VNC connection.

gnutls may have data available in its buffers, and we have our own peek
buffer temporarly storing data later to be processed. This would be
missed by the socket source, as it wouldn't get any notification about
it from epoll(). Deal with this by adding a custom source that
dispatches as long as there is data to read in those buffers.
---
 meson.build                                   |   1 +
 src/grd-enums.h                               |   6 +
 src/grd-session-vnc.c                         |  12 +
 src/grd-session-vnc.h                         |   6 +
 src/grd-settings-user.c                       |   4 +
 src/grd-settings.c                            |  18 +
 src/grd-vnc-server.c                          |  47 ++
 src/grd-vnc-tls.c                             | 537 ++++++++++++++++++
 src/grd-vnc-tls.h                             |  28 +
 src/meson.build                               |   3 +
 ...nome.desktop.remote-desktop.gschema.xml.in |  10 +
 11 files changed, 672 insertions(+)
 create mode 100644 src/grd-vnc-tls.c
 create mode 100644 src/grd-vnc-tls.h

diff --git a/meson.build b/meson.build
index eb8bcaa96..068f84ec9 100644
--- a/meson.build
+++ b/meson.build
@@ -71,6 +71,7 @@ endif
 if have_vnc
   libvncclient_dep = dependency('libvncclient')
   libvncserver_dep = dependency('libvncserver')
+  gnutls_dep = dependency('gnutls')
 endif
 
 prefix = get_option('prefix')
diff --git a/src/grd-enums.h b/src/grd-enums.h
index 5221fcf74..b57934834 100644
--- a/src/grd-enums.h
+++ b/src/grd-enums.h
@@ -32,6 +32,12 @@ typedef enum
   GRD_VNC_AUTH_METHOD_PASSWORD
 } GrdVncAuthMethod;
 
+typedef enum
+{
+  GRD_VNC_ENCRYPTION_NONE = 1 << 0,
+  GRD_VNC_ENCRYPTION_TLS_ANON = 1 << 1,
+} GrdVncEncryption;
+
 typedef enum
 {
   GRD_VNC_SCREEN_SHARE_MODE_MIRROR_PRIMARY,
diff --git a/src/grd-session-vnc.c b/src/grd-session-vnc.c
index 0e28f8461..02f575e13 100644
--- a/src/grd-session-vnc.c
+++ b/src/grd-session-vnc.c
@@ -632,6 +632,12 @@ check_rfb_password (rfbClientPtr  rfb_client,
     }
 }
 
+int
+grd_session_vnc_get_fd (GrdSessionVnc *session_vnc)
+{
+  return session_vnc->rfb_screen->inetdSock;
+}
+
 int
 grd_session_vnc_get_stride_for_width (GrdSessionVnc *session_vnc,
                                       int            width)
@@ -652,6 +658,12 @@ grd_session_vnc_get_socket_connection (GrdSessionVnc *session_vnc)
   return session_vnc->connection;
 }
 
+rfbClientPtr
+grd_session_vnc_get_rfb_client (GrdSessionVnc *session_vnc)
+{
+  return session_vnc->rfb_client;
+}
+
 static void
 init_vnc_session (GrdSessionVnc *session_vnc)
 {
diff --git a/src/grd-session-vnc.h b/src/grd-session-vnc.h
index f682b11a5..097b513ba 100644
--- a/src/grd-session-vnc.h
+++ b/src/grd-session-vnc.h
@@ -65,6 +65,8 @@ void grd_session_vnc_set_client_clipboard_text (GrdSessionVnc *session_vnc,
 int grd_session_vnc_get_stride_for_width (GrdSessionVnc *session_vnc,
                                           int            width);
 
+int grd_session_vnc_get_fd (GrdSessionVnc *session_vnc);
+
 gboolean grd_session_vnc_is_client_gone (GrdSessionVnc *session_vnc);
 
 void grd_session_vnc_notify_error (GrdSessionVnc *session_vnc);
@@ -73,10 +75,14 @@ GrdVncServer * grd_session_vnc_get_server (GrdSessionVnc *session_vnc);
 
