diff --git a/src/grd-vnc-tls.c b/src/grd-vnc-tls.c
new file mode 100644
index 000000000..779475503
--- /dev/null
+++ b/src/grd-vnc-tls.c
@@ -0,0 +1,537 @@
+/*
