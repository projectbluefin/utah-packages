From 9622015bd0c44b6e2a2c923bd70b711d3f54d6d1 Mon Sep 17 00:00:00 2001
From: glitchfox <glitchfox@benjaminali.com>
Date: Thu, 30 Jul 2026 06:49:53 +0000
Subject: [PATCH 1/2] Fix signed-integer-overflow UB in big-endian 32-bit reads
 (parsers)

The format parsers assemble 32-bit big-endian values a byte at a time, e.g.
`tmp_val = *midi_data++ << 24;`. The uint8_t operand promotes to int, so when
the top byte's high bit is set, `value << 24` shifts into/past the int sign
bit -- undefined behavior (UBSan: "left shift of 255 by 24 places cannot be
represented in type 'int'"). This fires on the normal MIDI/XMI/MUS/HMP/HMI
loading paths and when reading GUS patch headers; found with AFL++ + UBSan.

Cast the shifted byte to uint32_t so the shift is well-defined unsigned
arithmetic. The computed value is unchanged on two's-complement targets; only
the `<< 24` term can overflow (`<< 16` / `<< 8` on a byte stay within int), so
those are left as-is. 25 sites across f_midi, f_xmidi, f_hmi, f_hmp, gus_pat,
and mus2mid.

Signed-off-by: glitchfox <glitchfox@benjaminali.com>
---
 src/f_hmi.c   |  4 ++--
 src/f_hmp.c   | 16 ++++++++--------
 src/f_midi.c  |  4 ++--
 src/f_xmidi.c | 12 ++++++------
 src/gus_pat.c | 12 ++++++------
 src/mus2mid.c |  2 +-
 6 files changed, 25 insertions(+), 25 deletions(-)

diff --git a/src/f_hmi.c b/src/f_hmi.c
index 14ca8c51..85833a88 100644
--- a/src/f_hmi.c
+++ b/src/f_hmi.c
@@ -143,7 +143,7 @@ _WM_ParseNewHmi(const uint8_t *hmi_data, uint32_t hmi_size) {
         hmi_track_offset[i] = *hmi_data++;
         hmi_track_offset[i] += (*hmi_data++ << 8);
         hmi_track_offset[i] += (*hmi_data++ << 16);
-        hmi_track_offset[i] += (*hmi_data++ << 24);
+        hmi_track_offset[i] += ((uint32_t)*hmi_data++ << 24);
 
         if (hmi_size < (hmi_track_offset[i] + 0x5a + 4)) {
             _WM_GLOBAL_ERROR(WM_ERR_NOT_HMI, "file too short", 0);
@@ -160,7 +160,7 @@ _WM_ParseNewHmi(const uint8_t *hmi_data, uint32_t hmi_size) {
         hmi_track_header_length[i] = hmi_addr[0x57];
         hmi_track_header_length[i] += (hmi_addr[0x58] << 8);
         hmi_track_header_length[i] += (hmi_addr[0x59] << 16);
-        hmi_track_header_length[i] += (hmi_addr[0x5a] << 24);
+        hmi_track_header_length[i] += ((uint32_t)hmi_addr[0x5a] << 24);
 
         /* GHSA-f2xg-2rq9-xvhm: header length is file-controlled; bound it
          * against the remaining buffer so the pointer advance below cannot
