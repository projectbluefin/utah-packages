From ea903841963bafbcc064657c6c5ac958514de0d2 Mon Sep 17 00:00:00 2001
From: glitchfox <glitchfox@benjaminali.com>
Date: Thu, 30 Jul 2026 10:46:36 +0000
Subject: [PATCH 2/2] mus2mid: cast all READ_INT32 operands to uint32_t
 (consistency)

Per review (@sezero): match hmi2mid.c's macro style by casting every byte
rather than only the <<24 term. No behavioural change.

Signed-off-by: glitchfox <glitchfox@benjaminali.com>
---
 src/mus2mid.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/mus2mid.c b/src/mus2mid.c
index d7ab212b..fcce478e 100644
--- a/src/mus2mid.c
+++ b/src/mus2mid.c
@@ -211,7 +211,7 @@ static int32_t writevarlen(int32_t value, uint8_t *out)
 }
 
 #define READ_INT16(b) ((b)[0] | ((b)[1] << 8))
-#define READ_INT32(b) ((b)[0] | ((b)[1] << 8) | ((b)[2] << 16) | ((uint32_t)(b)[3] << 24))
+#define READ_INT32(b) ((uint32_t)(b)[0] | ((uint32_t)(b)[1] << 8) | ((uint32_t)(b)[2] << 16) | ((uint32_t)(b)[3] << 24))
 
 int _WM_mus2midi(const uint8_t *in, uint32_t insize,
                  uint8_t **out, uint32_t *outsize,
