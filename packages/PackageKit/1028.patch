From b7e5a477b8ff64288f6da92c3a221c105922b8ed Mon Sep 17 00:00:00 2001
From: Frank Gehann <fg@fgehann.de>
Date: Sun, 11 Oct 2026 08:54:53 +0200
Subject: [PATCH 7/8] dnf5: Preserve transferred bytes across download retries

Keep applying the full progress delta to downloaded size, but count the current attempt's downloaded bytes when progress resets. This prevents retries from subtracting previously transferred bytes from the speed accounting.

Add a regression test covering a retry reset and subsequent progress. The backend builds and all 23 dnf5 tests pass.

(cherry picked from commit 1864904c2a4bb466a7ab06f28eb2dc9fb14c0332)
---
 backends/dnf5/dnf5-backend-utils.cpp |  6 ++++--
 backends/dnf5/tests/dnf5-tests.cpp   | 28 ++++++++++++++++++++++++++++
 2 files changed, 32 insertions(+), 2 deletions(-)

diff --git a/backends/dnf5/dnf5-backend-utils.cpp b/backends/dnf5/dnf5-backend-utils.cpp
index 6f5837ff2..0c79bbefe 100644
--- a/backends/dnf5/dnf5-backend-utils.cpp
+++ b/backends/dnf5/dnf5-backend-utils.cpp
@@ -782,8 +782,10 @@ Dnf5DownloadCallbacks::progress(void *user_cb_data, double total_to_download, do
 
 	// only registered packages count towards the download size
 	if (package_ids.empty() || !item.package_id.empty()) {
-		downloaded_size += downloaded - item.downloaded;
-		transferred_size += downloaded - item.downloaded;
+		double delta = downloaded - item.downloaded;
+		downloaded_size += delta;
+		// A retry resets progress without undoing bytes already transferred.
+		transferred_size += delta >= 0 ? delta : downloaded;
 	}
 
 	// the second stage of a repository metadata download
diff --git a/backends/dnf5/tests/dnf5-tests.cpp b/backends/dnf5/tests/dnf5-tests.cpp
index 5f43e54b0..b8f6f3b52 100644
--- a/backends/dnf5/tests/dnf5-tests.cpp
+++ b/backends/dnf5/tests/dnf5-tests.cpp
@@ -249,6 +249,33 @@ dnf5_test_download_speed(void)
 	g_assert_cmpuint(dnf5_test_job.speeds.back(), ==, 0);
 }
 
+static void
+dnf5_test_download_speed_retry(void)
+{
+	dnf5_test_job.reset();
+	Dnf5DownloadCallbacks cb(test_job);
+	cb.add_package(FOO_NEVRA, FOO_ID, 1000);
+	void *foo = cb.add_new_download(nullptr, FOO_NEVRA, 1000);
+
+	cb.progress(foo, 1000, 800);
+	g_assert_cmpuint(dnf5_test_job.download_size_remaining.back(), ==, 200);
+
+	// A retry resets package progress, but its bytes still count towards speed.
+	g_usleep(G_USEC_PER_SEC + G_USEC_PER_SEC / 10);
+	cb.progress(foo, 1000, 100);
+	g_assert_cmpuint(dnf5_test_job.download_size_remaining.back(), ==, 900);
+	g_assert_cmpuint(dnf5_test_job.speeds.size(), ==, 1);
+	g_assert_cmpuint(dnf5_test_job.speeds.back(), >, 0);
+	g_assert_cmpuint(dnf5_test_job.speeds.back(), <=, 100);
+
+	g_usleep(G_USEC_PER_SEC + G_USEC_PER_SEC / 10);
+	cb.progress(foo, 1000, 300);
+	g_assert_cmpuint(dnf5_test_job.download_size_remaining.back(), ==, 700);
+	g_assert_cmpuint(dnf5_test_job.speeds.size(), ==, 2);
+	g_assert_cmpuint(dnf5_test_job.speeds.back(), >, 0);
+	g_assert_cmpuint(dnf5_test_job.speeds.back(), <=, 200);
+}
+
 static void
 dnf5_test_download_speed_starts_with_data(void)
 {
@@ -567,6 +594,7 @@ main(int argc, char **argv)
 	g_test_add_func("/dnf5/download/metadata-failed", dnf5_test_download_metadata_failed);
 	g_test_add_func("/dnf5/download/metadata-unknown-size", dnf5_test_download_metadata_unknown_size);
 	g_test_add_func("/dnf5/download/speed", dnf5_test_download_speed);
+	g_test_add_func("/dnf5/download/speed-retry", dnf5_test_download_speed_retry);
 	g_test_add_func("/dnf5/download/speed-starts-with-data", dnf5_test_download_speed_starts_with_data);
 	g_test_add_func("/dnf5/download/speed-ignores-existing", dnf5_test_download_speed_ignores_existing);
 	g_test_add_func("/dnf5/transaction/phases", dnf5_test_transaction_phases);

From 8d558c9e2422417f051edeef0af783a758e3d7f2 Mon Sep 17 00:00:00 2001
From: Frank Gehann <fg@fgehann.de>
Date: Sat, 17 Oct 2026 16:34:15 +0200
Subject: [PATCH 8/8] dnf5: Exclude non-RPM actions from progress weighting

Only register inbound and outbound transaction packages. Reason changes do not receive RPM progress callbacks and must not dilute the progress shares of installed and removed packages.
---
 backends/dnf5/dnf5-backend-utils.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/backends/dnf5/dnf5-backend-utils.cpp b/backends/dnf5/dnf5-backend-utils.cpp
index 0c79bbefe..41c5ecef9 100644
--- a/backends/dnf5/dnf5-backend-utils.cpp
+++ b/backends/dnf5/dnf5-backend-utils.cpp
@@ -859,8 +859,12 @@ Dnf5TransactionCallbacks::Dnf5TransactionCallbacks(PkBackendJob *job)
 void
 Dnf5TransactionCallbacks::add_package(const libdnf5::base::TransactionPackage &item)
 {
+	auto action = item.get_action();
+	bool inbound = libdnf5::transaction::transaction_item_action_is_inbound(action);
+	if (!inbound && !libdnf5::transaction::transaction_item_action_is_outbound(action))
+		return;
+
 	auto pkg = item.get_package();
-	bool inbound = libdnf5::transaction::transaction_item_action_is_inbound(item.get_action());
 	add_package(pkg.get_full_nevra(), inbound, pkg.get_install_size());
 }
 
