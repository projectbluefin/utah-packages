diff -up rtmpdump-2.6/librtmp/hashswf.c.orig rtmpdump-2.6/librtmp/hashswf.c
--- rtmpdump-2.6/librtmp/hashswf.c.orig	2025-11-14 13:19:40.000000000 +0100
+++ rtmpdump-2.6/librtmp/hashswf.c	2026-07-31 20:25:25.100403245 +0200
@@ -51,7 +51,7 @@
 #define HMAC_CTX	struct hmac_sha256_ctx
 #define HMAC_setup(ctx, key, len)	hmac_sha256_set_key(&ctx, len, key)
 #define HMAC_crunch(ctx, buf, len)	hmac_sha256_update(&ctx, len, buf)
-#define HMAC_finish(ctx, dig, dlen)	dlen = SHA256_DIGEST_LENGTH; hmac_sha256_digest(&ctx, SHA256_DIGEST_LENGTH, dig)
+#define HMAC_finish(ctx, dig, dlen)	dlen = SHA256_DIGEST_LENGTH; hmac_sha256_digest(&ctx, dig)
 #define HMAC_close(ctx)
 #else	/* USE_OPENSSL */
 #include <openssl/ssl.h>
