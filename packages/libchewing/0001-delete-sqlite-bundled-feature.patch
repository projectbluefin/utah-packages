From ab2f172db6b44c0f1e55b020e0077a5a4676eefd Mon Sep 17 00:00:00 2001
From: Kan-Ru Chen <kanru@kanru.info>
Date: Sat, 4 Jul 2026 08:45:19 +0900
Subject: [PATCH] delete sqlite-bundled feature

---
 Cargo.toml       | 1 -
 capi/Cargo.toml  | 1 -
 tools/Cargo.toml | 1 -
 3 files changed, 3 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index e8a4c2d4..feb7959b 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -48,7 +48,6 @@ tempfile = { workspace = true }
 [features]
 default = []
 sqlite = ["dep:rusqlite"]
-sqlite-bundled = ["rusqlite/bundled", "sqlite"]
 
 [profile.release]
 opt-level = 3
diff --git a/capi/Cargo.toml b/capi/Cargo.toml
index c51380d7..f62eafcd 100644
--- a/capi/Cargo.toml
+++ b/capi/Cargo.toml
@@ -19,4 +19,3 @@ tempfile = { workspace = true }
 
 [features]
 sqlite = ["chewing/sqlite"]
-sqlite-bundled = ["sqlite", "chewing/sqlite-bundled"]
diff --git a/tools/Cargo.toml b/tools/Cargo.toml
index 9857fb6e..a70e1c6a 100644
--- a/tools/Cargo.toml
+++ b/tools/Cargo.toml
@@ -19,4 +19,3 @@ optional = true
 [features]
 mangen = ["dep:clap_mangen"]
 sqlite = ["chewing/sqlite"]
-sqlite-bundled = ["sqlite", "chewing/sqlite-bundled"]
-- 
2.55.0

